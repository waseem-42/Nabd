{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-start.sh\"",
            "timeout": 60,
            "statusMessage": "مزامنة نبض مع GitHub..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-push.sh\"",
            "timeout": 90,
            "statusMessage": "حفظ ورفع التعديلات..."
          }
        ]
      }
    ]
  }
}
